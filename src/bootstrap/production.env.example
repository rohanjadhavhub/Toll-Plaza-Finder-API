# Copy to .env.production on EC2. Supply real credentials only in that gitignored file.
DB_URL=jdbc:postgresql://your-neon-direct-host.neon.tech/your_database?sslmode=require&channelBinding=require
DB_USERNAME=your_read_only_application_role
DB_PASSWORD=replace-with-your-neon-password
GOOGLE_MAPS_API_KEY=replace-with-your-google-key
API_PORT=8080
API_IMAGE=toll-plaza-finder:production
CORRIDOR_METERS=50
